<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vairagi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Android 12+ Splash Screen Theme -->
    <style name="Theme.Vairagi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FAF7F2</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Vairagi</item>
    </style>
</resources>
