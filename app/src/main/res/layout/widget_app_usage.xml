<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_leaf" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Vairagi Screen Time"
            android:textColor="#8FBC94"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_total_screen_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0m"
            android:textColor="#FAF7F2"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#4A7C59" />

    <!-- Top App Rows Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- App 1 Row -->
        <LinearLayout
            android:id="@+id/widget_app1_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_app1_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="App Icon" />

            <TextView
                android:id="@+id/widget_app1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FAF7F2"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_app1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8FBC94"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- App 2 Row -->
        <LinearLayout
            android:id="@+id/widget_app2_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_app2_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="App Icon" />

            <TextView
                android:id="@+id/widget_app2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FAF7F2"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_app2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8FBC94"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- App 3 Row -->
        <LinearLayout
            android:id="@+id/widget_app3_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_app3_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="App Icon" />

            <TextView
                android:id="@+id/widget_app3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FAF7F2"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_app3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8FBC94"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
